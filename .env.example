AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# v2 browser sign-in: tenant of the resource's subscription, not your home tenant.
AZURE_OPENAI_TENANT_ID=YOUR-RESOURCE-TENANT-ID
# Leave empty to use Microsoft Entra ID. Never put a real key in this example.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_ASTRA=
AZURE_OPENAI_DEPLOYMENT_LUNA=
AZURE_OPENAI_DEPLOYMENT_SOL=
# Optional: a separately provisioned, supported Batch deployment.
AZURE_OPENAI_BATCH_DEPLOYMENT=
# Optional: a separately provisioned image-generation deployment.
AZURE_OPENAI_IMAGE_DEPLOYMENT=
